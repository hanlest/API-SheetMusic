# Copia a .env y pon tu token de lectura de Hugging Face.
# https://huggingface.co/settings/tokens
# Acepta antes la licencia: https://huggingface.co/MuScriptor/muscriptor-medium
HF_TOKEN=hf_

# Segundos sin transcripción antes de liberar VRAM (servidor HTTP). 0 = modelo siempre cargado.
MUSCRIPTOR_IDLE_UNLOAD_SECONDS=60
